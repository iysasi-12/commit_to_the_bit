# Copy this file to .env and fill in what you have. Never commit .env.
# Anything left blank falls back to demo mode (when DEMO_MODE=true) so the
# app still runs; the UI shows a banner naming every part that is a demo.

# ---- App ----
PORT=3000
# The address people open in the browser. Must match the Google redirect URI host.
PUBLIC_URL=http://localhost:3000
# Long random string used to sign sessions and encrypt stored Google tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# true = allow the "Try demo" sign-in and use stand-ins for any service without keys.
DEMO_MODE=true
# Hours to keep generated summaries and audio before they are deleted automatically.
CACHE_TTL_HOURS=72

# ---- Google (Gmail, read-only) ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to PUBLIC_URL + /auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Anthropic (writes the summaries and sorts emails into categories) ----
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
ANTHROPIC_MODEL=
# "default" lets the API retry a declined request on a fallback model; "off" disables it.
ANTHROPIC_REFUSAL_FALLBACK=default

# ---- ElevenLabs (reads the summaries aloud, voice cloning) ----
ELEVENLABS_API_KEY=
# Optional. Default: eleven_multilingual_v2 (stable long-form speech, 10,000 chars/request).
ELEVENLABS_MODEL_ID=
# Optional. Default: mp3_44100_128
ELEVENLABS_OUTPUT_FORMAT=
# Optional voice ID to use before a person picks one. Default: first ElevenLabs default voice.
ELEVENLABS_DEFAULT_VOICE_ID=
