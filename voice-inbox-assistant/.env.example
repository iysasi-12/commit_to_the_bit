# Copy to .env.local and fill in. Never commit .env.local.

# Google Cloud Console > Google Auth Platform > Clients > Web application
# Add BOTH redirect URIs so sign-in works on this computer and on the live site:
#   http://localhost:3000/api/auth/callback/google
#   https://vocamail.biz/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session encryption secret (32+ random characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
AUTH_SECRET=

# The address the app runs at.
# This computer (npm.cmd run dev), also the presentation backup if the live site is down:
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# The live site. The server gets these from the deploy automatically, so they stay commented here:
# NEXTAUTH_URL=https://vocamail.biz
# AUTH_URL=https://vocamail.biz

# Google AI Studio > Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Set to true ONLY after turning on billing for this key's Google Cloud project. It changes the
# privacy page: on the free tier Google may use content sent to Gemini to improve its products.
GEMINI_PAID_TIER=false
# Optional. Default gemini-3.8-flash; the fallback is used once if that model is busy.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ElevenLabs > Developers > API Keys (needs Text to Speech, Voices write, Voice Generation)
ELEVENLABS_API_KEY=

# Everyone shares this one ElevenLabs account, but each person's saved and cloned voices are
# private to them. Admins (comma-separated Google emails) can also see and remove voices made
# before owner tags existed and the shared character voices.
ADMIN_EMAILS=
# How many voices each non-admin person may keep (voice slots are shared by everyone).
VOICES_PER_USER=3
# Secret behind the private owner tags on voices. Use the SAME value on your computer and on the
# server (GitHub secret VOICE_OWNER_SECRET), so people keep their voices in both places.
VOICE_OWNER_SECRET=

# Shown on /privacy as the contact for questions and deletion requests (Google verification needs one).
CONTACT_EMAIL=
