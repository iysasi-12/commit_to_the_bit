{
  "manifest_version": 3,
  "name": "Voice Inbox Assistant",
  "version": "0.9.0",
  "description": "Adds a Summarize button to Gmail that opens Voice Inbox Assistant in a side panel on that Gmail tab only.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost:3000/*", "https://vocamail.biz/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Voice Inbox Assistant works on Gmail (mail.google.com)"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
